/* ── Views do Workspace ── */

#channels-manager, #channel-detail, #home-menu {
    width: 100%;
    height: 100%;
    padding: 0;
    layout: vertical;
}

/* Área Rolável Interna */
#channels-content-area, #detail-content-area {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

.view-header {
    height: 3;
    width: 100%;
    border-bottom: ascii $panel;
    margin-bottom: 1;
    content-align: left middle;
}

.view-title {
    color: $secondary;
    text-style: bold;
    margin-left: 1;
}

/* ── Tabelas Estilizadas ── */
#channels-table, #schedules-table {
    height: auto;
    min-height: 5;
    border: ascii $panel;
    background: $background;
    color: $foreground;
    margin-bottom: 1;
}

/* Cabeçalho - Centralizado */
DataTable > .datatable--header {
    background: $surface;
    color: $secondary;
    text-style: bold;
    text-align: center;
}

/* Células - Centralizadas */
DataTable > .datatable--cell {
    text-align: center;
    border-right: ascii $panel;
}

/* ── Detalhes do Canal ── */
#detail-container {
    padding: 1 2;
    background: $surface;
    margin-bottom: 1;
    border: ascii $panel;
    height: auto;
}

#detail-info-grid {
    grid-size: 2;
    grid-columns: 15 1fr;
    height: auto;
    margin-bottom: 1;
}

.section-header {
    height: 3;
    width: 100%;
    margin: 1 0;
    align: left middle;
}

.section-label {
    color: $primary;
    text-style: bold;
    width: 1fr;
}

/* ── Barra de Ações (CORRIGIDA) ── */
.action-bar {
    height: 5; /* Aumentado de 3 para 5 para dar espaço aos botões e bordas */
    width: 100%;
    padding: 0 2;
    align: right middle;
    border-top: ascii $panel;
    background: $surface;
}

.btn-action {
    margin-left: 1;
    min-width: 16;
    height: 3;
}
