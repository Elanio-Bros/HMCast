/* ── Módulo de Canais (Específico) ── */

#channels-manager, #channel-detail {
    width: 100%;
    height: 100%;
    layout: vertical;
}

#channels-content-area, #detail-content-area {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

/* IDs específicos para herdar Grid e Container do Main */
#detail-container {
    height: auto;
}

#detail-info-grid {
    height: auto;
}
