Screen {
    background: $background;
    color: $foreground;
}

/* ── Hero Section (Cabeçalho Fixo) ── */
#hero-section {
    height: auto;
    width: 100%;
    background: $surface; 
    margin: 1 4 3 4;
    padding: 1 3;
    border: ascii $panel;
}

#hero-banner {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

#hero-title {
    width: 100%;
    color: $secondary;
    text-style: bold;
}

/* ── System Metrics Grid (Tabela NOC) ── */
#system-metrics-grid {
    height: auto;
    grid-size: 6 2;
    grid-columns: 10 1fr 10 1fr 10 1fr;
    grid-rows: 1 1;
    margin-top: 1;
    background: transparent;
}

.m-label {
    color: $text-muted;
    text-style: bold;
}

.m-val {
    color: $foreground;
}

.m-val.ok {
    color: $secondary;
    text-style: bold;
}

.m-val.warning {
    color: $warning;
    text-style: bold;
}

.m-val.error {
    color: $error;
    text-style: bold;
}

/* ── Workspace (Container de Conteúdo Dinâmico) ── */
#workspace {
    height: 1fr;           /* Diminui a altura para se ajustar ao conteúdo */
    width: 100%;
    background: $surface;    /* Mesma cor do hero-section */
    margin: 0 4 1 4;         
    padding: 1 2;
    border: ascii $panel;    /* Mesmo estilo de borda do hero-section */
}

/* ── Card Grid System ── */
.card-row {
    height: auto;
    width: 100%;
    margin-bottom: 0;        /* Mais compacto */
}

.card {
    width: 1fr;
    height: auto;
    background: $background; /* Cards agora são levemente mais escuros que o workspace */
    border: ascii $panel;
    margin: 1;               /* Espaçamento entre cards */
    padding: 1 2;
}

.card:hover {
    border: ascii $primary;
    background: $primary 5%;
}

.card-number {
    width: 5;
    height: 100%;
    color: $secondary;
    text-style: bold;
    content-align: center top;
    margin-right: 2;
    border-right: ascii $panel;
}

.card-content {
    width: 1fr;
    height: auto;
}

.card-title {
    color: $foreground;
    text-style: bold;
}

.card-subtitle {
    color: $secondary;
    text-style: italic;
    opacity: 0.8;
}

.card-desc {
    color: $text-muted;
    margin-top: 1;
}
