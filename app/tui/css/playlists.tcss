/* ── Módulo de Playlists ── */

#playlists-manager, #playlist-detail {
    width: 100%;
    height: 100%;
    layout: vertical;
}

#playlists-content-area, #playlist-detail-content-area {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

/* ── Componentes de View (Isolados) ── */
.view-header {
    height: 3;
    width: 100%;
    border-bottom: ascii $panel;
    margin-bottom: 1;
    content-align: left middle;
}

.view-title {
    color: $secondary;
    text-style: bold;
    margin-left: 1;
}

.action-bar {
    height: 5;
    width: 100%;
    padding: 0 2;
    align: right middle;
    border-top: ascii $panel;
    background: $surface;
}

.btn-action {
    margin-left: 1;
    min-width: 16;
    height: 3;
}

/* ── Tabelas ASCII (Isoladas para este módulo) ── */
DataTable {
    height: auto;
    min-height: 5;
    border: ascii $panel;
    background: $background;
    color: $foreground;
    margin: 1 0;
}

DataTable > .datatable--header {
    background: $surface;
    color: $secondary;
    text-style: bold;
    text-align: center;
}

DataTable > .datatable--cell {
    text-align: center;
    border-right: ascii $panel;
}

/* Container de Detalhes da Playlist */
#playlist-detail-container {
    padding: 1 2;
    background: $surface;
    margin-bottom: 1;
    border: ascii $panel;
    height: auto;
}

#playlist-info-grid {
    grid-size: 2;
    grid-columns: 15 1fr;
    height: auto;
    margin-bottom: 1;
}
