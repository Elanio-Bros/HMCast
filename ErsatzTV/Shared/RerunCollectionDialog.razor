@using ErsatzTV.Application.MediaCollections
@using ErsatzTV.Application.MediaItems
@using ErsatzTV.Application.Search
@using ErsatzTV.Core
@using ErsatzTV.Core.Domain
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4 text-muted">
            @(IsEdit 
                ? "Update rerun marathon configuration and playback rules." 
                : "Create a rerun collection for marathons, separating first-run sequential episodes and reruns.")
        </MudText>

        @if (_isLoading)
        {
            <div class="d-flex justify-center my-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudTextField @bind-Value="_name"
                          Label="Rerun Collection Name"
                          Placeholder="e.g. Daily Simpsons Marathon, Star Trek Chrono"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          AutoFocus="true" />

            <MudSelect T="CollectionType"
                       Value="_collectionType"
                       ValueChanged="OnCollectionTypeChanged"
                       Label="Collection Type"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="mb-4">
                <MudSelectItem Value="CollectionType.TelevisionShow">Television Show</MudSelectItem>
                <MudSelectItem Value="CollectionType.TelevisionSeason">Television Season</MudSelectItem>
                <MudSelectItem Value="CollectionType.Artist">Artist</MudSelectItem>
                <MudSelectItem Value="CollectionType.Collection">Collection</MudSelectItem>
                <MudSelectItem Value="CollectionType.SmartCollection">Smart Collection</MudSelectItem>
                <MudSelectItem Value="CollectionType.MultiCollection">Multi Collection</MudSelectItem>
            </MudSelect>

            @if (_collectionType == CollectionType.TelevisionShow)
            {
                <MudAutocomplete T="NamedMediaItemViewModel"
                                 @bind-Value="_selectedMediaItem"
                                 Label="Television Show"
                                 Placeholder="Search shows..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchTelevisionShows"
                                 ToStringFunc="@(s => s?.Name)"
                                 Class="mb-4" />
            }
            else if (_collectionType == CollectionType.TelevisionSeason)
            {
                <MudAutocomplete T="NamedMediaItemViewModel"
                                 @bind-Value="_selectedMediaItem"
                                 Label="Television Season"
                                 Placeholder="Search seasons..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchTelevisionSeasons"
                                 ToStringFunc="@(s => s?.Name)"
                                 MaxItems="20"
                                 Class="mb-4" />
            }
            else if (_collectionType == CollectionType.Artist)
            {
                <MudAutocomplete T="NamedMediaItemViewModel"
                                 @bind-Value="_selectedMediaItem"
                                 Label="Artist"
                                 Placeholder="Search artists..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchArtists"
                                 ToStringFunc="@(s => s?.Name)"
                                 Class="mb-4" />
            }
            else if (_collectionType == CollectionType.Collection)
            {
                <MudAutocomplete T="MediaCollectionViewModel"
                                 @bind-Value="_selectedCollection"
                                 Label="Manual Collection"
                                 Placeholder="Search collections..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchCollections"
                                 ToStringFunc="@(c => c?.Name)"
                                 Class="mb-4" />
            }
            else if (_collectionType == CollectionType.SmartCollection)
            {
                <MudAutocomplete T="SmartCollectionViewModel"
                                 @bind-Value="_selectedSmartCollection"
                                 Label="Smart Collection"
                                 Placeholder="Search smart collections..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchSmartCollections"
                                 ToStringFunc="@(s => s?.Name)"
                                 Class="mb-4" />
            }
            else if (_collectionType == CollectionType.MultiCollection)
            {
                <MudAutocomplete T="MultiCollectionViewModel"
                                 @bind-Value="_selectedMultiCollection"
                                 Label="Multi Collection"
                                 Placeholder="Search multi collections..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="@SearchMultiCollections"
                                 ToStringFunc="@(m => m?.Name)"
                                 Class="mb-4" />
            }

            <MudDivider Class="my-4" />

            <div class="d-flex gap-4">
                <MudSelect T="PlaybackOrder"
                           @bind-Value="_firstRunOrder"
                           Label="First-Run Order"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="flex: 1;">
                    <MudSelectItem Value="PlaybackOrder.Chronological">Chronological</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Random">Random</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Shuffle">Shuffle</MudSelectItem>
                </MudSelect>

                <MudSelect T="PlaybackOrder"
                           @bind-Value="_rerunOrder"
                           Label="Rerun Order"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="flex: 1;">
                    <MudSelectItem Value="PlaybackOrder.Chronological">Chronological</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Random">Random</MudSelectItem>
                    <MudSelectItem Value="PlaybackOrder.Shuffle">Shuffle</MudSelectItem>
                </MudSelect>
            </div>
            <MudText Typo="Typo.caption" Class="text-muted d-block mt-2">
                First-run order controls the order in which new episodes/items are scheduled. Rerun order controls how previously aired items replay.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(string.IsNullOrWhiteSpace(_name) || !HasValidTarget() || _isSaving || _isLoading)"
                   OnClick="Save">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEdit ? "Save Changes" : "Create Rerun Collection")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public int Id { get; set; }

    private bool IsEdit => Id > 0;

    private string _name;
    private CollectionType _collectionType = CollectionType.TelevisionShow;
    private NamedMediaItemViewModel _selectedMediaItem;
    private MediaCollectionViewModel _selectedCollection;
    private SmartCollectionViewModel _selectedSmartCollection;
    private MultiCollectionViewModel _selectedMultiCollection;

    private PlaybackOrder _firstRunOrder = PlaybackOrder.Chronological;
    private PlaybackOrder _rerunOrder = PlaybackOrder.Shuffle;

    private bool _isLoading;
    private bool _isSaving;

    protected override async Task OnParametersSetAsync()
    {
        if (IsEdit)
        {
            _isLoading = true;
            try
            {
                var maybe = await Mediator.Send(new GetRerunCollectionById(Id));
                maybe.Match(
                    rc =>
                    {
                        _name = rc.Name;
                        _collectionType = rc.CollectionType;
                        _selectedCollection = rc.Collection;
                        _selectedMultiCollection = rc.MultiCollection;
                        _selectedSmartCollection = rc.SmartCollection;
                        _selectedMediaItem = rc.MediaItem;
                        _firstRunOrder = rc.FirstRunPlaybackOrder;
                        _rerunOrder = rc.RerunPlaybackOrder;
                    },
                    () =>
                    {
                        Snackbar.Add("Rerun collection not found", Severity.Error);
                        MudDialog.Cancel();
                    });
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading rerun collection: {ex.Message}", Severity.Error);
                MudDialog.Cancel();
            }
            finally
            {
                _isLoading = false;
            }
        }
        else
        {
            _isLoading = false;
        }
    }

    private void OnCollectionTypeChanged(CollectionType newType)
    {
        _collectionType = newType;
        _selectedMediaItem = null;
        _selectedCollection = null;
        _selectedSmartCollection = null;
        _selectedMultiCollection = null;

        if (_collectionType == CollectionType.MultiCollection)
        {
            _firstRunOrder = PlaybackOrder.Shuffle;
            _rerunOrder = PlaybackOrder.Shuffle;
        }
        else
        {
            _firstRunOrder = PlaybackOrder.Chronological;
            _rerunOrder = PlaybackOrder.Shuffle;
        }
    }

    private bool HasValidTarget() => _collectionType switch
    {
        CollectionType.TelevisionShow => _selectedMediaItem != null,
        CollectionType.TelevisionSeason => _selectedMediaItem != null,
        CollectionType.Artist => _selectedMediaItem != null,
        CollectionType.Collection => _selectedCollection != null,
        CollectionType.SmartCollection => _selectedSmartCollection != null,
        CollectionType.MultiCollection => _selectedMultiCollection != null,
        _ => false
    };

    private void Cancel() => MudDialog.Cancel();

    private async Task<IEnumerable<NamedMediaItemViewModel>> SearchTelevisionShows(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return new List<NamedMediaItemViewModel>();
        return await Mediator.Send(new SearchTelevisionShows(value), cancellationToken);
    }

    private async Task<IEnumerable<NamedMediaItemViewModel>> SearchTelevisionSeasons(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return new List<NamedMediaItemViewModel>();
        return await Mediator.Send(new SearchTelevisionSeasons(value), cancellationToken);
    }

    private async Task<IEnumerable<NamedMediaItemViewModel>> SearchArtists(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return new List<NamedMediaItemViewModel>();
        return await Mediator.Send(new SearchArtists(value), cancellationToken);
    }

    private async Task<IEnumerable<MediaCollectionViewModel>> SearchCollections(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return new List<MediaCollectionViewModel>();
        return await Mediator.Send(new SearchCollections(value), cancellationToken);
    }

    private async Task<IEnumerable<SmartCollectionViewModel>> SearchSmartCollections(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return new List<SmartCollectionViewModel>();
        return await Mediator.Send(new SearchSmartCollections(value), cancellationToken);
    }

    private async Task<IEnumerable<MultiCollectionViewModel>> SearchMultiCollections(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)) return new List<MultiCollectionViewModel>();
        return await Mediator.Send(new SearchMultiCollections(value), cancellationToken);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name) || !HasValidTarget()) return;

        _isSaving = true;
        try
        {
            if (IsEdit)
            {
                var command = new UpdateRerunCollection(
                    Id,
                    _name.Trim(),
                    _collectionType,
                    _selectedCollection,
                    _selectedMultiCollection,
                    _selectedSmartCollection,
                    _selectedMediaItem,
                    _firstRunOrder,
                    _rerunOrder);

                var result = await Mediator.Send(command);
                result.Match(
                    Left: error =>
                    {
                        Snackbar.Add($"Error updating rerun collection: {error.Value}", Severity.Error);
                    },
                    Right: _ =>
                    {
                        Snackbar.Add($"Rerun collection '{_name}' updated successfully.", Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    });
            }
            else
            {
                var command = new CreateRerunCollection(
                    _name.Trim(),
                    _collectionType,
                    _selectedCollection,
                    _selectedMultiCollection,
                    _selectedSmartCollection,
                    _selectedMediaItem,
                    _firstRunOrder,
                    _rerunOrder);

                var result = await Mediator.Send(command);
                result.Match(
                    Left: error =>
                    {
                        Snackbar.Add($"Error creating rerun collection: {error.Value}", Severity.Error);
                    },
                    Right: rc =>
                    {
                        Snackbar.Add($"Rerun collection '{rc.Name}' created successfully.", Severity.Success);
                        MudDialog.Close(DialogResult.Ok(rc));
                    });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
