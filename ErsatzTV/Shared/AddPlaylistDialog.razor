@using ErsatzTV.Application.MediaCollections
@using ErsatzTV.Core
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4 text-muted">Create a new sequential playlist.</MudText>
        <MudTextField @bind-Value="_playlistName" 
                      Label="Playlist Name" 
                      Placeholder="e.g. S01 Marathon, Best of Halloween" 
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(string.IsNullOrWhiteSpace(_playlistName) || _isSaving)" OnClick="Save">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create Playlist
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    private string _playlistName;
    private bool _isSaving;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_playlistName)) return;

        _isSaving = true;
        try
        {
            var result = await Mediator.Send(new CreatePlaylist(_playlistName.Trim()));
            result.Match(
                Left: error =>
                {
                    Snackbar.Add($"Error creating playlist: {error.Value}", Severity.Error);
                    return LanguageExt.Unit.Default;
                },
                Right: playlist =>
                {
                    Snackbar.Add($"Playlist '{playlist.Name}' created successfully.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(playlist));
                    return LanguageExt.Unit.Default;
                });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
