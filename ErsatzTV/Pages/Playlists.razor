@page "/playlists"
@page "/media/playlists"
@using ErsatzTV.Application.MediaCollections
@using ErsatzTV.Shared
@implements IDisposable
@inject ILogger<Playlists> Logger
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject IDialogService Dialog

<MudForm Style="max-height: 100%">
    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
            <!-- HEADER WITH ACTIONS -->
            <div class="d-flex flex-wrap justify-space-between align-center mb-6">
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">Playlists</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">Gerencie seus roteiros sequenciais atemporais de programação contínua.</MudText>
                </div>
                <div class="d-flex gap-2 mt-2 mt-sm-0">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.PlaylistAdd" 
                               OnClick="OpenAddPlaylistDialog">
                        Nova Playlist
                    </MudButton>
                </div>
            </div>

            <MudDivider Class="mb-6"/>

            @if (_isLoading)
            {
                <div class="d-flex justify-center my-12">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                </div>
            }
            else if (!_playlists.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center" Outlined="true" Style="border-style: dashed;">
                    <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Large" Class="mb-2 text-muted" />
                    <MudText Typo="Typo.h6" Class="text-muted">Nenhuma playlist encontrada</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted mb-4">Crie sua primeira playlist para montar roteiros sequenciais de mídia.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="OpenAddPlaylistDialog">
                        Criar Playlist
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudTable Items="_playlists" Dense="true" Hover="true" Elevation="1" Class="mb-6">
                    <HeaderContent>
                        <MudTh>Nome da Playlist</MudTh>
                        <MudTh Style="width: 140px; text-align: center;">Tipo</MudTh>
                        <MudTh Style="width: 160px; text-align: right;">Ações</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nome">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Medium" Color="Color.Primary" Class="mr-3" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@context.Name</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Tipo" Style="text-align: center;">
                            @if (context.IsSystem)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                    Sistema / Trakt
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                    Manual
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <MudTooltip Text="Editar Nome da Playlist">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                               Size="Size.Small" 
                                               Color="Color.Default" 
                                               Disabled="@context.IsSystem"
                                               OnClick="() => OpenEditPlaylistDialog(context)" />
                            </MudTooltip>
                            <MudTooltip Text="Editar Roteiro e Itens">
                                <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered" 
                                               Size="Size.Small" 
                                               Color="Color.Primary" 
                                               Href="@($"media/playlists/{context.Id}")" />
                            </MudTooltip>
                            <MudTooltip Text="@(context.IsSystem ? "Playlists de sistema não podem ser excluídas" : "Excluir Playlist")">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Size="Size.Small" 
                                               Color="Color.Error" 
                                               Disabled="@context.IsSystem"
                                               OnClick="() => DeletePlaylist(context)" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;
    private List<PlaylistViewModel> _playlists = new();
    private bool _isLoading = true;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            _playlists = await Mediator.Send(new GetAllPlaylists(), token);
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar playlists: {ex.Message}", Severity.Error);
            Logger.LogError(ex, "Erro ao carregar playlists");
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenAddPlaylistDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<PlaylistDialog>("Nova Playlist", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
        }
    }

    private async Task OpenEditPlaylistDialog(PlaylistViewModel playlist)
    {
        var parameters = new DialogParameters
        {
            { "Id", playlist.Id }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<PlaylistDialog>("Editar Playlist", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
        }
    }

    private async Task DeletePlaylist(PlaylistViewModel playlist)
    {
        var parameters = new DialogParameters { { "EntityType", "playlist" }, { "EntityName", playlist.Name } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await Dialog.ShowAsync<DeleteDialog>("Excluir Playlist", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var deleteResult = await Mediator.Send(new DeletePlaylist(playlist.Id), _cts.Token);
            foreach (var error in deleteResult)
            {
                Snackbar.Add(error.ToString(), Severity.Error);
                return;
            }

            Snackbar.Add($"Playlist '{playlist.Name}' excluída com sucesso.", Severity.Info);
            await LoadData();
        }
    }
}
