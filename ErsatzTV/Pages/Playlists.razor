@page "/media/playlists"
@using ErsatzTV.Application.MediaCollections
@using ErsatzTV.Application.Tree
@using ErsatzTV.Shared
@implements IDisposable
@inject ILogger<Playlists> Logger
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject IDialogService Dialog

<MudForm Style="max-height: 100%">
    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
            <!-- HEADER WITH ACTIONS -->
            <div class="d-flex flex-wrap justify-space-between align-center mb-6">
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">Playlists</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">Manage sequential playlists organized into playlist groups.</MudText>
                </div>
                <div class="d-flex gap-2 mt-2 mt-sm-0">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.CreateNewFolder" 
                               OnClick="OpenAddPlaylistGroupDialog">
                        New Playlist Group
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.PlaylistAdd" 
                               OnClick="() => OpenAddPlaylistDialog()">
                        New Playlist
                    </MudButton>
                </div>
            </div>

            <MudDivider Class="mb-6"/>

            @if (_isLoading)
            {
                <div class="d-flex justify-center my-12">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                </div>
            }
            else if (!_groups.Any())
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center" Outlined="true" Style="border-style: dashed;">
                    <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Large" Class="mb-2 text-muted" />
                    <MudText Typo="Typo.h6" Class="text-muted">No playlist groups found</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted mb-4">Create your first group to start organizing your playlists.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="OpenAddPlaylistGroupDialog">
                        Create Playlist Group
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @foreach (var group in _groups)
                    {
                        <MudExpansionPanel Text="@group.Name" Expanded="@(!group.IsSystem)" Class="mb-3" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 6px;">
                            <TitleContent>
                                <div class="d-flex justify-space-between align-center width-100 pr-4">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Class="mr-3" />
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@group.Name</MudText>
                                        @if (group.IsSystem)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2" Style="font-size: 0.7rem; height: 20px;">
                                                System
                                            </MudChip>
                                        }
                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled" Class="ml-3">
                                            @group.Children.Count @(group.Children.Count == 1 ? "playlist" : "playlists")
                                        </MudChip>
                                    </div>
                                    <div class="d-flex align-center gap-1" @onclick:stopPropagation="true">
                                        @if (!group.IsSystem)
                                        {
                                            <MudTooltip Text="Add Playlist to this Group">
                                                <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                                               Size="Size.Small" 
                                                               Color="Color.Default" 
                                                               OnClick="() => OpenAddPlaylistDialog(group.Id)" />
                                            </MudTooltip>
                                            <MudTooltip Text="Delete Group">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                               Size="Size.Small" 
                                                               Color="Color.Error" 
                                                               OnClick="() => DeleteGroup(group)" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                @if (group.Children.Any())
                                {
                                    <MudTable Items="group.Children" Dense="true" Hover="true" Elevation="0" Outlined="false">
                                        <HeaderContent>
                                            <MudTh>Playlist Name</MudTh>
                                            <MudTh Style="width: 120px; text-align: right;">Actions</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Name">
                                                <div class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Small" Class="mr-2 text-muted" />
                                                    <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                                                    @if (context.IsSystem)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2" Style="font-size: 0.7rem; height: 20px;">
                                                            System (Trakt)
                                                        </MudChip>
                                                    }
                                                </div>
                                            </MudTd>
                                            <MudTd Style="text-align: right;">
                                                <MudTooltip Text="Edit Playlist Properties">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                                   Size="Size.Small" 
                                                                   Color="Color.Default" 
                                                                   Disabled="@context.IsSystem"
                                                                   OnClick="() => OpenEditPlaylistDialog(context)" />
                                                </MudTooltip>
                                                <MudTooltip Text="Edit Playlist Items">
                                                    <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered" 
                                                                   Size="Size.Small" 
                                                                   Color="Color.Default" 
                                                                   Href="@($"media/playlists/{context.Id}")" />
                                                </MudTooltip>
                                                <MudTooltip Text="@(context.IsSystem ? "System playlists are managed by Trakt and cannot be deleted here" : "Delete Playlist")">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                                   Size="Size.Small" 
                                                                   Color="Color.Error" 
                                                                   Disabled="@context.IsSystem"
                                                                   OnClick="() => DeletePlaylist(context)" />
                                                </MudTooltip>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                                else
                                {
                                    <div class="pa-4 d-flex align-center justify-space-between" style="background: rgba(255,255,255,0.02); border-radius: 4px;">
                                        <MudText Typo="Typo.body2" Class="text-muted">No playlists in this group.</MudText>
                                        @if (!group.IsSystem)
                                        {
                                            <MudButton Variant="Variant.Text" 
                                                       Size="Size.Small" 
                                                       Color="Color.Primary" 
                                                       StartIcon="@Icons.Material.Filled.Add" 
                                                       OnClick="() => OpenAddPlaylistDialog(group.Id)">
                                                Add Playlist
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;
    private List<TreeGroupViewModel> _groups = new();
    private List<PlaylistGroupViewModel> _playlistGroups = new();
    private bool _isLoading = true;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            _playlistGroups = await Mediator.Send(new GetAllPlaylistGroups(), token);
            var tree = await Mediator.Send(new GetPlaylistTree(), token);
            _groups = tree.Groups ?? new();
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading playlists: {ex.Message}", Severity.Error);
            Logger.LogError(ex, "Error loading playlists");
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenAddPlaylistDialog(int? groupId = null)
    {
        var parameters = new DialogParameters
        {
            { "Groups", _playlistGroups.Where(g => !g.IsSystem).ToList() },
            { "InitialGroupId", groupId }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<PlaylistDialog>("New Playlist", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
        }
    }

    private async Task OpenEditPlaylistDialog(TreeItemViewModel playlist)
    {
        var parameters = new DialogParameters
        {
            { "Id", playlist.Id },
            { "Groups", _playlistGroups.Where(g => !g.IsSystem).ToList() }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<PlaylistDialog>("Edit Playlist", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
        }
    }

    private async Task OpenAddPlaylistGroupDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<AddPlaylistGroupDialog>("New Playlist Group", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
        }
    }

    private async Task DeletePlaylist(TreeItemViewModel playlist)
    {
        var parameters = new DialogParameters { { "EntityType", "playlist" }, { "EntityName", playlist.Name } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await Dialog.ShowAsync<DeleteDialog>("Delete Playlist", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var deleteResult = await Mediator.Send(new DeletePlaylist(playlist.Id), _cts.Token);
            foreach (var error in deleteResult)
            {
                Snackbar.Add(error.ToString(), Severity.Error);
                return;
            }

            Snackbar.Add($"Playlist '{playlist.Name}' deleted successfully.", Severity.Info);
            await LoadData();
        }
    }

    private async Task DeleteGroup(TreeGroupViewModel group)
    {
        var parameters = new DialogParameters { { "EntityType", "playlist group" }, { "EntityName", group.Name } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await Dialog.ShowAsync<DeleteDialog>("Delete Playlist Group", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var deleteResult = await Mediator.Send(new DeletePlaylistGroup(group.Id), _cts.Token);
            foreach (var error in deleteResult)
            {
                Snackbar.Add(error.ToString(), Severity.Error);
                return;
            }

            Snackbar.Add($"Playlist group '{group.Name}' deleted successfully.", Severity.Info);
            await LoadData();
        }
    }
}
