@page "/playouts"
@page "/playouts/add"
@page "/playouts/{Id:int}"
@using System.Globalization
@using ErsatzTV.Application.Configuration
@using ErsatzTV.Application.Playouts
@using ErsatzTV.Application.ProgramSchedules
@using ErsatzTV.Core.Domain
@using ErsatzTV.Core.Domain.Scheduling
@using ErsatzTV.Core.Notifications
@using ErsatzTV.Core.Scheduling
@using ErsatzTV.Shared
@using MediatR.Courier
@implements IDisposable
@inject IDialogService Dialog
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject ChannelWriter<IBackgroundServiceRequest> WorkerChannel
@inject IEntityLocker EntityLocker
@inject ICourier Courier
@inject ISnackbar Snackbar
@inject IStringLocalizer<ErsatzTV.Locals.Pages.Playouts> Loc
@inject IStringLocalizer<ErsatzTV.Locals.Shared.Common> CommonLoc

<MudForm Style="max-height: 100%">
    <MudPaper Square="true" Style="display: flex; height: 64px; min-height: 64px; width: 100%; z-index: 100; align-items: center">
        <div style="display: flex; flex-direction: row; margin-bottom: auto; margin-top: auto; width: 100%; align-items: center" class="ml-6 mr-6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenPlayoutDialog(null))">
                @Loc["Button_AddPlayout"]
            </MudButton>
            <div class="flex-grow-1"></div>
            <MudButton Class="ml-3" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@ResetAllPlayouts">
                @Loc["Button_ResetAll"]
            </MudButton>
        </div>
    </MudPaper>

    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-12">
            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 700;">@Loc["Title_Playouts"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Gerencie a programação contínua, playlists e agendamentos agrupados por canal de transmissão.
                    </MudText>
                </div>
                <div style="min-width: 300px;">
                    <MudTextField T="string"
                                  Value="@_searchString"
                                  ValueChanged="@OnSearch"
                                  Placeholder="@Loc["Search_Placeholder"]"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense">
                    </MudTextField>
                </div>
            </div>
            <MudDivider Class="mb-6"/>

            @if (_loading)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                </div>
            }
            else if (_currentPage.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    Nenhum playout encontrado. Clique no botão "Novo Playout" acima para vincular uma grade a um canal.
                </MudAlert>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Class="mb-6">
                    @foreach (var channelGroup in _currentPage.GroupBy(p => new { p.ChannelNumber, p.ChannelName, p.ChannelMode }).OrderBy(g => g.Key.ChannelNumber))
                    {
                        var hasActive = channelGroup.Any(p => p.IsEnabled);
                        <MudExpansionPanel>
                            <TitleContent>
                                <div class="d-flex align-center justify-space-between w-100 pr-4">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@(channelGroup.Key.ChannelMode == ChannelMode.Radio ? Icons.Material.Filled.Radio : Icons.Material.Filled.Tv)"
                                                 Color="@(hasActive ? Color.Success : Color.Default)"
                                                 Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">
                                                @channelGroup.Key.ChannelNumber - @channelGroup.Key.ChannelName
                                            </MudText>
                                        </div>
                                    </div>
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                            @(channelGroup.Key.ChannelMode == ChannelMode.Radio ? "Web Rádio" : "Canal TV")
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                            @channelGroup.Count() Playout(s)
                                        </MudChip>
                                        @if (hasActive)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
                                                @Loc["Status_OnAir"]
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined">
                                                @Loc["Status_Disabled"]
                                            </MudChip>
                                        }
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <MudTable Items="@channelGroup" Hover="true" Dense="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>@Loc["Header_Source"]</MudTh>
                                        <MudTh>@Loc["Header_Type"]</MudTh>
                                        <MudTh>@Loc["Header_Delivery"]</MudTh>
                                        <MudTh>@Loc["Header_Calendar"]</MudTh>
                                        <MudTh>@Loc["Header_Status"]</MudTh>
                                        <MudTh>@Loc["Header_Active"]</MudTh>
                                        <MudTh Style="text-align: right">@Loc["Header_Actions"]</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Fonte">
                                            @if (!string.IsNullOrWhiteSpace(context.ScheduleName))
                                            {
                                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.ScheduleName</MudText>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(context.ScheduleFile))
                                            {
                                                <MudTooltip Text="@context.ScheduleFile">
                                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@Path.GetFileName(context.ScheduleFile)</MudText>
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Roteiro Indefinido</MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Tipo">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                @context.SourceKind
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Entrega">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                                @context.DeliveryMode
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Calendário">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                                @context.CalendarMode
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Status">
                                            @switch (context.RuntimeStatus)
                                            {
                                                case PlayoutRuntimeStatus.ActiveInTransmission:
                                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">@Loc["Status_OnAir"]</MudChip>
                                                    break;
                                                case PlayoutRuntimeStatus.ScheduledFuture:
                                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Schedule">@Loc["Status_Scheduled"]</MudChip>
                                                    break;
                                                case PlayoutRuntimeStatus.OutOfPeriod:
                                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.HourglassEmpty">@Loc["Status_OutOfPeriod"]</MudChip>
                                                    break;
                                                default:
                                                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Status_Disabled"]</MudChip>
                                                    break;
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Ativo">
                                            <MudSwitch T="bool"
                                                       Value="@context.IsEnabled"
                                                       ValueChanged="@(val => OnToggleEnabled(context, val))"
                                                       Color="Color.Success"
                                                       Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)" />
                                        </MudTd>
                                        <MudTd Style="text-align: right">
                                            <div class="d-flex justify-end align-center">
                                                @if (EntityLocker.IsPlayoutLocked(context.PlayoutId))
                                                {
                                                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                                }

                                                <MudTooltip Text="Ver Linha do Tempo / Programação">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Timeline"
                                                                   Color="@(_selectedPlayoutId == context.PlayoutId ? Color.Primary : Color.Default)"
                                                                   OnClick="@(_ => PlayoutSelected(context))" />
                                                </MudTooltip>

                                                <MudTooltip Text="Editar Playout">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)"
                                                                   OnClick="@(() => OpenPlayoutDialog(context.PlayoutId))" />
                                                </MudTooltip>

                                                @if (context.ScheduleKind == PlayoutScheduleKind.Classic)
                                                {
                                                    <MudTooltip Text="Regenerar / Sincronizar">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                                       Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)"
                                                                       OnClick="@(_ => ResetPlayout(context))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="Agendar Reset Diário">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Update"
                                                                       Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)"
                                                                       OnClick="@(_ => ScheduleReset(context))" />
                                                    </MudTooltip>
                                                }
                                                else if (context.ScheduleKind == PlayoutScheduleKind.ExternalJson)
                                                {
                                                    <MudTooltip Text="Editar JSON Externo">
                                                        <MudIconButton Icon="@Icons.Material.Filled.DataObject"
                                                                       Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)"
                                                                       OnClick="@(_ => EditExternalJsonFile(context))" />
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <MudTooltip Text="Regenerar / Sincronizar">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                                       Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)"
                                                                       OnClick="@(_ => ResetPlayout(context))" />
                                                    </MudTooltip>
                                                }

                                                <MudTooltip Text="Excluir Playout">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   Disabled="@EntityLocker.IsPlayoutLocked(context.PlayoutId)"
                                                                   OnClick="@(_ => DeletePlayout(context))" />
                                                </MudTooltip>
                                            </div>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }

            @if (_selectedPlayoutId != null)
            {
                <MudPaper Class="pa-6 mt-8" Elevation="2" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Primary" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">@Loc["Label_PlayoutDetail"]</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Itens futuros ordenados por horário de exibição linear</MudText>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-4">
                            <MudSwitch T="bool" @bind-Value="@ShowFiller" Color="Color.Secondary" Label="Exibir Fillers / Intervalos"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _selectedPlayoutId = null)" />
                        </div>
                    </div>
                    <MudDivider Class="mb-4"/>

                    @if (!string.IsNullOrWhiteSpace(_buildMessage))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-4">@_buildMessage</MudAlert>
                    }

                    <MudTable Hover="true"
                              Dense="true"
                              @bind-RowsPerPage="@_detailRowsPerPage"
                              ServerData="@(new Func<TableState, CancellationToken, Task<TableData<PlayoutItemViewModel>>>(DetailServerReload))"
                              @ref="_detailTable"
                              RowClassFunc="PlayoutItemViewRowClassFunc">
                        <HeaderContent>
                            <MudTh>Início</MudTh>
                            <MudTh>Término</MudTh>
                            <MudTh>Item de Mídia / Episódio</MudTh>
                            <MudTh>Duração</MudTh>
                            <MudTh Style="width: 48px;"/>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Início">@context.Start.ToString("G", _dtf)</MudTd>
                            <MudTd DataLabel="Término">@context.Finish.ToString("G", _dtf)</MudTd>
                            <MudTd DataLabel="Item de Mídia">@context.Title</MudTd>
                            <MudTd DataLabel="Duração">@context.Duration</MudTd>
                            <MudTd>
                                @if (!string.IsNullOrWhiteSpace(context.SchedulingContext))
                                {
                                    <MudTooltip Text="Diagnóstico de Agendamento">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                       OnClick="@(_ => ShowSchedulingContext(context))"
                                                       Size="Size.Small"/>
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager RowsPerPageString="Itens por página:"/>
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            }
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;
    private readonly DateTimeFormatInfo _dtf = CultureInfo.CurrentCulture.DateTimeFormat;
    private readonly List<PlayoutNameViewModel> _currentPage = [];
    private MudTable<PlayoutItemViewModel> _detailTable;
    private int _detailRowsPerPage = 10;
    private string _searchString = string.Empty;
    private int? _selectedPlayoutId;
    private bool _showFiller;
    private string _buildMessage = string.Empty;
    private bool _loading = true;

    private bool ShowFiller
    {
        get => _showFiller;
        set
        {
            if (_showFiller != value)
            {
                _showFiller = value;
                if (_detailTable != null && _selectedPlayoutId != null)
                {
                    _detailTable.ReloadServerData();
                }
            }
        }
    }

    protected override void OnInitialized()
    {
        Courier.Subscribe<PlayoutUpdatedNotification>(HandlePlayoutUpdated);
    }

    public void Dispose()
    {
        Courier.UnSubscribe<PlayoutUpdatedNotification>(HandlePlayoutUpdated);
        _cts?.Cancel();
        _cts?.Dispose();
    }

    public async Task HandlePlayoutUpdated(PlayoutUpdatedNotification notification, CancellationToken cancellationToken)
    {
        try
        {
            if (!notification.IsLocked)
            {
                await InvokeAsync(LoadPlayoutsAsync);

                if (notification.PlayoutId == _selectedPlayoutId)
                {
                    if (_detailTable != null)
                    {
                        await InvokeAsync(() => _detailTable.ReloadServerData());
                    }
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // ignore
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            _detailRowsPerPage = await Mediator.Send(new GetConfigElementByKey(ConfigElementKey.PlayoutsDetailPageSize), token)
                .Map(maybeRows => maybeRows.Match(ce => int.TryParse(ce.Value, out int rows) ? rows : 10, () => 10));
            _showFiller = await Mediator.Send(new GetConfigElementByKey(ConfigElementKey.PlayoutsDetailShowFiller), token)
                .Map(maybeShow => maybeShow.Match(ce => bool.TryParse(ce.Value, out bool show) && show, () => false));

            await LoadPlayoutsAsync();

            if (!_dialogOpened && (NavigationManager.Uri.EndsWith("/add", StringComparison.OrdinalIgnoreCase) || (Id.HasValue && Id.Value > 0)))
            {
                _dialogOpened = true;
                _ = InvokeAsync(async () =>
                {
                    await OpenPlayoutDialog(Id);
                    _dialogOpened = false;
                });
            }
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
    }

    [Parameter]
    public int? Id { get; set; }

    private bool _dialogOpened;

    private async Task OpenPlayoutDialog(int? playoutId)
    {
        var parameters = new DialogParameters();
        if (playoutId.HasValue && playoutId.Value > 0)
        {
            parameters.Add("Id", playoutId.Value);
        }

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        string title = (playoutId.HasValue && playoutId.Value > 0) ? "Editar Playout Universal" : "Novo Playout Universal";
        IDialogReference dialog = await Dialog.ShowAsync<UniversalPlayoutDialog>(title, parameters, options);
        DialogResult result = await dialog.Result;

        if (NavigationManager.Uri.EndsWith("/add", StringComparison.OrdinalIgnoreCase) || (Id.HasValue && Id.Value > 0))
        {
            NavigationManager.NavigateTo("playouts", replace: true);
            Id = null;
        }

        if (result is { Canceled: false })
        {
            await LoadPlayoutsAsync();
        }
    }

    private async Task LoadPlayoutsAsync()
    {
        _loading = true;
        try
        {
            PagedPlayoutsViewModel data = await Mediator.Send(new GetPagedPlayouts(_searchString, 0, 500), _cts.Token);
            _currentPage.Clear();
            _currentPage.AddRange(data.Page);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string query)
    {
        _searchString = query;
        await LoadPlayoutsAsync();
    }

    private async Task OnToggleEnabled(PlayoutNameViewModel playout, bool isEnabled)
    {
        var result = await Mediator.Send(new TogglePlayoutEnabled(playout.PlayoutId, isEnabled), _cts.Token);
        result.Match(
            _ =>
            {
                Snackbar.Add(Loc["Msg_EnabledSuccess"], Severity.Success);
            },
            error =>
            {
                Snackbar.Add($"{Loc["Msg_EnabledError"]} {error.Value}", Severity.Error);
            });

        await LoadPlayoutsAsync();
    }

    private async Task PlayoutSelected(PlayoutNameViewModel playout)
    {
        if (_selectedPlayoutId == playout.PlayoutId)
        {
            _selectedPlayoutId = null;
            return;
        }

        _selectedPlayoutId = playout.PlayoutId;
        _buildMessage = !(playout.BuildStatus?.Success ?? false) && !string.IsNullOrWhiteSpace(playout.BuildStatus?.Message)
            ? playout.BuildStatus.Message
            : string.Empty;

        if (_detailTable != null)
        {
            await _detailTable.ReloadServerData();
        }
    }

    private async Task EditExternalJsonFile(PlayoutNameViewModel playout)
    {
        var parameters = new DialogParameters { { "ScheduleFile", $"{playout.ScheduleFile}" } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge };

        IDialogReference dialog = await Dialog.ShowAsync<EditExternalJsonFileDialog>("Edit External Json File", parameters, options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Mediator.Send(new UpdateExternalJsonPlayout(playout.PlayoutId, result.Data as string ?? playout.ScheduleFile), _cts.Token);
            await LoadPlayoutsAsync();
            _selectedPlayoutId = null;
        }
    }

    private async Task DeletePlayout(PlayoutNameViewModel playout)
    {
        var parameters = new DialogParameters
        {
            { "EntityType", "playout" },
            { "EntityName", $"{playout.ScheduleName} on {playout.ChannelNumber} - {playout.ChannelName}" }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        IDialogReference dialog = await Dialog.ShowAsync<DeleteDialog>("Delete Playout", parameters, options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Mediator.Send(new DeletePlayout(playout.PlayoutId), _cts.Token);
            await LoadPlayoutsAsync();

            if (_selectedPlayoutId == playout.PlayoutId)
            {
                _selectedPlayoutId = null;
            }
        }
    }

    private async Task ResetAllPlayouts()
    {
        _selectedPlayoutId = null;
        await Mediator.Send(new ResetAllPlayouts(), _cts.Token);
        await LoadPlayoutsAsync();
        Snackbar.Add("Todos os playouts foram reiniciados.", Severity.Info);
    }

    private async Task ResetPlayout(PlayoutNameViewModel playout)
    {
        PlayoutBuildMode mode = playout.ScheduleKind switch
        {
            PlayoutScheduleKind.Classic => PlayoutBuildMode.Refresh,
            _ => PlayoutBuildMode.Reset
        };

        await WorkerChannel.WriteAsync(new BuildPlayout(playout.PlayoutId, mode), _cts.Token);
        Snackbar.Add($"Sincronização iniciada para {playout.ChannelNumber} - {playout.ChannelName}.", Severity.Info);
    }

    private async Task ScheduleReset(PlayoutNameViewModel playout)
    {
        var parameters = new DialogParameters
        {
            { "PlayoutId", playout.PlayoutId },
            { "ChannelName", playout.ChannelName },
            { "ScheduleName", playout.ScheduleName },
            { "DailyResetTime", playout.DailyRebuildTime }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        IDialogReference dialog = await Dialog.ShowAsync<SchedulePlayoutReset>("Schedule Playout Reset", parameters, options);
        await dialog.Result;

        await LoadPlayoutsAsync();
    }

    private async Task<TableData<PlayoutItemViewModel>> DetailServerReload(TableState state, CancellationToken cancellationToken)
    {
        await Mediator.Send(new SaveConfigElementByKey(ConfigElementKey.PlayoutsDetailPageSize, state.PageSize.ToString()), cancellationToken);
        await Mediator.Send(new SaveConfigElementByKey(ConfigElementKey.PlayoutsDetailShowFiller, _showFiller.ToString()), cancellationToken);

        if (_selectedPlayoutId.HasValue)
        {
            PagedPlayoutItemsViewModel data =
                await Mediator.Send(new GetFuturePlayoutItemsById(_selectedPlayoutId.Value, _showFiller, state.Page, state.PageSize), cancellationToken);

            return new TableData<PlayoutItemViewModel>
            {
                TotalItems = data.TotalCount,
                Items = data.Page
            };
        }

        return new TableData<PlayoutItemViewModel> { TotalItems = 0 };
    }

    private string PlayoutItemViewRowClassFunc(PlayoutItemViewModel item, int index)
    {
        return "playout-filler-" + item.FillerKind.Match(
            fk => fk.ToString().ToLower(),
            () => "unscheduled");
    }

    private async Task ShowSchedulingContext(PlayoutItemViewModel item)
    {
        Option<string> maybeResults = await Mediator.Send(new ProcessSchedulingContext(item.SchedulingContext), _cts.Token);
        foreach (string result in maybeResults)
        {
            var parameters = new DialogParameters { { "Context", result } };
            var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            IDialogReference dialog = await Dialog.ShowAsync<SchedulingContextDialog>(item.Title, parameters, options);
            DialogResult _ = await dialog.Result;
        }
    }
}
