        <MudStack Row="true" Breakpoint="Breakpoint.SmAndDown" Class="form-field-stack gap-md-8 mb-5">
            <div class="d-flex">
                <MudText>Marathon Shuffle Items</MudText>
            </div>
            <MudCheckBox @bind-Value="_selectedItem.MarathonShuffleItems"
