@page "/media/commercials"
@using ErsatzTV.Application.Commercials
@using ErsatzTV.Core.Domain
@using ErsatzTV.Shared
@implements IDisposable
@inject IDialogService Dialog
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IStringLocalizer<ErsatzTV.Locals.Pages.Commercials> Loc
@inject IStringLocalizer<ErsatzTV.Locals.Shared.Common> CommonLoc

<MudForm Style="max-height: 100%">
    <MudPaper Square="true" Style="display: flex; height: 64px; min-height: 64px; width: 100%; z-index: 100; align-items: center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-6" StartIcon="@Icons.Material.Filled.Add" OnClick="@AddCommercialPresetAsync">
            @Loc["Button_AddCommercial"]
        </MudButton>
    </MudPaper>

    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-12">
            <div class="d-flex align-center justify-space-between mb-4">
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 700;">@Loc["Title_Commercials"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Loc["Subtitle_Commercials"]</MudText>
                </div>
                <div style="min-width: 300px;">
                    <MudTextField T="string"
                                  @bind-Value="_searchQuery"
                                  Placeholder="Filtrar comerciais..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </div>
            </div>
            <MudDivider Class="mb-6"/>

            @if (_loading)
            {
                <div class="d-flex justify-center my-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                </div>
            }
            else if (_presets.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    Nenhum comercial ou vinheta cadastrado. Clique no botão acima para adicionar um novo preset.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@FilteredPresets" Hover="true" Dense="true" Elevation="1" Class="mb-6">
                    <HeaderContent>
                        <MudTh>@Loc["Header_Name"]</MudTh>
                        <MudTh>@Loc["Header_Kind"]</MudTh>
                        <MudTh>@Loc["Header_Collection"]</MudTh>
                        <MudTh>@Loc["Header_TargetDuration"]</MudTh>
                        <MudTh>@Loc["Header_PadSeconds"]</MudTh>
                        <MudTh>@Loc["Header_PlaybackOrder"]</MudTh>
                        <MudTh Style="text-align: right">@Loc["Header_Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nome">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@context.Name</MudText>
                        </MudTd>
                        <MudTd DataLabel="Tipo">
                            @switch (context.Kind)
                            {
                                case CommercialKind.Preroll:
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Pré-Roll</MudChip>
                                    break;
                                case CommercialKind.Midroll:
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">Mid-Roll</MudChip>
                                    break;
                                case CommercialKind.Postroll:
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Pós-Roll</MudChip>
                                    break;
                                case CommercialKind.Pad:
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Pad</MudChip>
                                    break;
                                default:
                                    <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Outlined">Filler</MudChip>
                                    break;
                            }
                        </MudTd>
                        <MudTd DataLabel="Coleção">
                            @if (!string.IsNullOrWhiteSpace(context.CollectionName))
                            {
                                <MudText Typo="Typo.body2">@context.CollectionName</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Item Específico</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Duração Alvo">
                            @(context.TargetDuration.HasValue ? context.TargetDuration.Value.ToString(@"mm\:ss") : "Livre")
                        </MudTd>
                        <MudTd DataLabel="Pad">
                            @(context.PadSeconds.HasValue ? $"{context.PadSeconds.Value}s" : "-")
                        </MudTd>
                        <MudTd DataLabel="Ordem">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.PlaybackOrder</MudChip>
                        </MudTd>
                        <MudTd Style="text-align: right">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditCommercialPresetAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Excluir">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCommercialPresetAsync(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;
    private List<CommercialPresetViewModel> _presets = [];
    private string _searchQuery = string.Empty;
    private bool _loading = true;

    private IEnumerable<CommercialPresetViewModel> FilteredPresets =>
        string.IsNullOrWhiteSpace(_searchQuery)
            ? _presets
            : _presets.Where(p => p.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  (p.CollectionName?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadPresetsAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task LoadPresetsAsync()
    {
        _loading = true;
        try
        {
            _presets = await Mediator.Send(new GetAllCommercialPresets(), _cts.Token);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddCommercialPresetAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        IDialogReference dialog = await Dialog.ShowAsync<CommercialPresetDialog>(Loc["Dialog_AddTitle"], options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(Loc["Msg_Saved"], Severity.Success);
            await LoadPresetsAsync();
        }
    }

    private async Task EditCommercialPresetAsync(CommercialPresetViewModel preset)
    {
        var parameters = new DialogParameters { { "Preset", preset } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        IDialogReference dialog = await Dialog.ShowAsync<CommercialPresetDialog>(Loc["Dialog_EditTitle"], parameters, options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(Loc["Msg_Saved"], Severity.Success);
            await LoadPresetsAsync();
        }
    }

    private async Task DeleteCommercialPresetAsync(CommercialPresetViewModel preset)
    {
        var parameters = new DialogParameters
        {
            { "EntityType", "comercial" },
            { "EntityName", preset.Name }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        IDialogReference dialog = await Dialog.ShowAsync<DeleteDialog>("Excluir Comercial", parameters, options);
        DialogResult result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Mediator.Send(new DeleteCommercialPreset(preset.Id), _cts.Token);
            Snackbar.Add(Loc["Msg_Deleted"], Severity.Info);
            await LoadPresetsAsync();
        }
    }
}
