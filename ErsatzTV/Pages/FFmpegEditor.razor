@* Replaced by shared FFmpegProfileDialog modal *@
@using System.Runtime.InteropServices
@using ErsatzTV.Application.FFmpegProfiles
@using ErsatzTV.Application.Resolutions
@using ErsatzTV.Core.Domain
@using ErsatzTV.Core.FFmpeg
@using ErsatzTV.FFmpeg.Format
@using ErsatzTV.Validators
@using FluentValidation.Results
@using Microsoft.Extensions.Caching.Memory
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ILogger<FFmpegEditor> Logger
@inject ISnackbar Snackbar
@inject IMediator Mediator
@inject IMemoryCache MemoryCache
@inject PersistentComponentState ApplicationState

<MudForm Model="@_model" @ref="@_form" Validation="@(_validator.ValidateValue)" ValidationDelay="0" Style="max-height: 100%">
    <MudPaper Square="true" Style="display: flex; height: 64px; min-height: 64px; width: 100%; z-index: 100; align-items: center">
        <div class="d-flex align-center gap-3 ml-6 mr-6 w-100">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleSubmitAsync" StartIcon="@(IsEdit ? Icons.Material.Filled.Save : Icons.Material.Filled.Add)">
                @(IsEdit ? "Salvar Perfil" : "Criar Perfil")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="ffmpeg">
                Cancelar
            </MudButton>
            <div class="flex-grow-1"></div>
            <div class="d-none d-lg-flex align-center gap-2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Predefinições de Fábrica:</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@ApplyPreset1080p">1080p Full HD</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" OnClick="@ApplyPreset720p">720p HD</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@ApplyPreset480p">480p SD</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@ApplyPresetAudioOnly">Áudio Puro (Rádio)</MudChip>
            </div>
        </div>
    </MudPaper>

    <div class="d-flex flex-column" style="height: calc(100vh - 64px); overflow-y: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
            <!-- Informações Gerais Básicas -->
            <MudPaper Class="pa-4 mb-5" Elevation="1" Style="background: #11141a; border-radius: 8px;">
                <div class="d-flex flex-wrap gap-4 align-center">
                    <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Nome do Perfil FFmpeg" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 2; min-width: 250px;" Required="true" />
                    <MudNumericField T="int" @bind-Value="_model.ThreadCount" Label="Threads de Transcodificação (0 = Auto)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1; min-width: 180px;" Min="0" Max="64" />
                </div>
            </MudPaper>

            <!-- Grid 2x2 Operacional -->
            <MudGrid Spacing="4">
                <!-- QUADRANTE 1: VÍDEO -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4 h-100">
                        <MudCardHeader Class="pa-0 mb-3">
                            <CardHeaderContent>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Videocam" Color="Color.Primary" />
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="fw-bold">1. Processamento de Vídeo</MudText>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            @if (_model.NormalizeVideo)
                            {
                                <MudSelect T="ResolutionViewModel" @bind-Value="_model.Resolution" For="@(() => _model.Resolution)" Label="Resolução Broadcast" Margin="Margin.Dense" Class="mb-3">
                                    @foreach (ResolutionViewModel resolution in _resolutions)
                                    {
                                        <MudSelectItem Value="@resolution">@resolution.Name</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSelect T="FFmpegProfileVideoFormat" @bind-Value="_model.VideoFormat" For="@(() => _model.VideoFormat)" Label="Codec de Vídeo" Margin="Margin.Dense" Class="mb-3">
                                    <MudSelectItem Value="@FFmpegProfileVideoFormat.H264">H.264 / AVC (Máxima Compatibilidade)</MudSelectItem>
                                    <MudSelectItem Value="@FFmpegProfileVideoFormat.Hevc">H.265 / HEVC (Alta Eficiência)</MudSelectItem>
                                    <MudSelectItem Value="@FFmpegProfileVideoFormat.Mpeg2Video">MPEG-2 (Legado Broadcast)</MudSelectItem>
                                </MudSelect>

                                <div class="d-flex gap-3 mb-3">
                                    <MudNumericField T="int" @bind-Value="_model.VideoBitrate" For="@(() => _model.VideoBitrate)" Label="Bitrate de Vídeo (kBit/s)" Margin="Margin.Dense" Min="100" Max="50000" />
                                    <MudNumericField T="int" @bind-Value="_model.VideoBufferSize" For="@(() => _model.VideoBufferSize)" Label="Buffer (kBit)" Margin="Margin.Dense" Min="100" Max="100000" />
                                </div>

                                <div class="d-flex gap-3 mb-3">
                                    <MudSelect T="FFmpegProfileBitDepth" @bind-Value="_model.BitDepth" For="@(() => _model.BitDepth)" Label="Profundidade de Cor" Margin="Margin.Dense">
                                        <MudSelectItem Value="@FFmpegProfileBitDepth.EightBit">8-bit SDR</MudSelectItem>
                                        <MudSelectItem Value="@FFmpegProfileBitDepth.TenBit">10-bit HDR</MudSelectItem>
                                    </MudSelect>
                                    <MudSelect T="string" @bind-Value="_model.VideoProfile" For="@(() => _model.VideoProfile)" Label="Perfil H.264" Margin="Margin.Dense" Clearable="true">
                                        <MudSelectItem T="string" Value="@VideoProfile.Main">Main</MudSelectItem>
                                        <MudSelectItem T="string" Value="@VideoProfile.High">High</MudSelectItem>
                                    </MudSelect>
                                </div>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                    Normalização de Vídeo desativada. O fluxo de vídeo original será repassado diretamente (Copy / Stream Passthrough). Ideal para canais de Rádio Web com áudio puro.
                                </MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- QUADRANTE 2: ÁUDIO -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4 h-100">
                        <MudCardHeader Class="pa-0 mb-3">
                            <CardHeaderContent>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Color="Color.Secondary" />
                                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="fw-bold">2. Processamento de Áudio</MudText>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            @if (_model.NormalizeAudio)
                            {
                                <MudSelect T="FFmpegProfileAudioFormat" @bind-Value="_model.AudioFormat" For="@(() => _model.AudioFormat)" Label="Codec de Áudio" Margin="Margin.Dense" Class="mb-3">
                                    <MudSelectItem Value="@FFmpegProfileAudioFormat.Aac">AAC (Padrão Streaming)</MudSelectItem>
                                    <MudSelectItem Value="@FFmpegProfileAudioFormat.Ac3">AC3 / Dolby Digital</MudSelectItem>
                                    <MudSelectItem Value="@FFmpegProfileAudioFormat.AacLatm">AAC LATM (DVB-C)</MudSelectItem>
                                </MudSelect>

                                <div class="d-flex gap-3 mb-3">
                                    <MudNumericField T="int" @bind-Value="_model.AudioBitrate" For="@(() => _model.AudioBitrate)" Label="Bitrate de Áudio (kBit/s)" Margin="Margin.Dense" Min="32" Max="640" />
                                    <MudNumericField T="int" @bind-Value="_model.AudioBufferSize" For="@(() => _model.AudioBufferSize)" Label="Buffer (kBit)" Margin="Margin.Dense" Min="32" Max="1280" />
                                </div>

                                <div class="d-flex gap-3 mb-3">
                                    <MudNumericField T="int" @bind-Value="_model.AudioChannels" For="@(() => _model.AudioChannels)" Label="Canais (2 = Estéreo, 6 = 5.1)" Margin="Margin.Dense" Min="1" Max="8" />
                                    <MudNumericField T="int" @bind-Value="_model.AudioSampleRate" For="@(() => _model.AudioSampleRate)" Label="Taxa de Amostragem (kHz)" Margin="Margin.Dense" Min="32" Max="96" />
                                </div>

                                <div class="d-flex gap-3 mb-3">
                                    <MudSelect T="NormalizeLoudnessMode" @bind-Value="_model.NormalizeLoudnessMode" For="@(() => _model.NormalizeLoudnessMode)" Label="Nivelamento de Volume" Margin="Margin.Dense">
                                        <MudSelectItem Value="@NormalizeLoudnessMode.Off">Desativado (Off)</MudSelectItem>
                                        <MudSelectItem Value="@NormalizeLoudnessMode.LoudNorm">EBU R128 (loudnorm)</MudSelectItem>
                                    </MudSelect>
                                    @if (_model.NormalizeLoudnessMode is NormalizeLoudnessMode.LoudNorm)
                                    {
                                        <MudTextField T="double?" @bind-Value="_model.TargetLoudness" For="@(() => _model.TargetLoudness)" Label="Alvo LUFS (ex: -24)" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="LUFS" />
                                    }
                                </div>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                    Normalização de Áudio desativada. O fluxo de áudio original será copiado sem transcodificação.
                                </MudAlert>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- QUADRANTE 3: ACELERAÇÃO POR HARDWARE -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4 h-100">
                        <MudCardHeader Class="pa-0 mb-3">
                            <CardHeaderContent>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Success" />
                                    <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="fw-bold">3. Aceleração de Hardware (GPU)</MudText>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <MudSelect T="HardwareAccelerationKind" @bind-Value="_model.HardwareAcceleration" For="@(() => _model.HardwareAcceleration)" Label="Método de Aceleração" Margin="Margin.Dense" Class="mb-3">
                                @foreach (HardwareAccelerationKind hwAccel in _hardwareAccelerationKinds)
                                {
                                    <MudSelectItem Value="@hwAccel">@hwAccel</MudSelectItem>
                                }
                            </MudSelect>

                            @if (RuntimeInformation.IsOSPlatform(OSPlatform.Linux) && _model.HardwareAcceleration is HardwareAccelerationKind.Vaapi)
                            {
                                <div class="d-flex gap-3 mb-3">
                                    <MudSelect T="VaapiDriver" @bind-Value="_model.VaapiDriver" For="@(() => _model.VaapiDriver)" Label="Driver VAAPI" Margin="Margin.Dense">
                                        @foreach (VaapiDriver driver in Enum.GetValues<VaapiDriver>())
                                        {
                                            <MudSelectItem Value="@driver">@driver</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSelect T="string" @bind-Value="_model.VaapiDevice" For="@(() => _model.VaapiDevice)" Label="Dispositivo VAAPI" Margin="Margin.Dense">
                                        @foreach (string device in _vaapiDevices)
                                        {
                                            <MudSelectItem Value="@device">@device</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            }

                            @if (_model.HardwareAcceleration == HardwareAccelerationKind.Qsv)
                            {
                                <MudNumericField T="int?" @bind-Value="_model.QsvExtraHardwareFrames" Label="QSV Extra Hardware Frames" Margin="Margin.Dense" Class="mb-3" />
                            }

                            <MudSelect T="FFmpegProfileTonemapAlgorithm" @bind-Value="_model.TonemapAlgorithm" For="@(() => _model.TonemapAlgorithm)" Label="Algoritmo de Tonemapping HDR" Margin="Margin.Dense">
                                @foreach (FFmpegProfileTonemapAlgorithm algorithm in Enum.GetValues<FFmpegProfileTonemapAlgorithm>())
                                {
                                    <MudSelectItem Value="@algorithm">@algorithm</MudSelectItem>
                                }
                            </MudSelect>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- QUADRANTE 4: FILTROS & FLAGS DE EMISSORA -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4 h-100">
                        <MudCardHeader Class="pa-0 mb-3">
                            <CardHeaderContent>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Warning" />
                                    <MudText Typo="Typo.subtitle1" Color="Color.Warning" Class="fw-bold">4. Filtros &amp; Flags de Transmissão</MudText>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div class="d-flex flex-wrap gap-4 mb-3">
                                <MudCheckBox T="bool" @bind-Value="_model.NormalizeVideo" Color="Color.Primary" Label="Normalizar Vídeo" Dense="true" />
                                <MudCheckBox T="bool" @bind-Value="_model.NormalizeAudio" Color="Color.Secondary" Label="Normalizar Áudio" Dense="true" />
                                <MudCheckBox T="bool" @bind-Value="_model.NormalizeFramerate" Color="Color.Info" Label="Normalizar FPS" Dense="true" />
                                <MudCheckBox T="bool" @bind-Value="_model.NormalizeColors" Color="Color.Warning" Label="Normalizar Cores" Dense="true" />
                                <MudCheckBox T="bool" @bind-Value="_model.DeinterlaceVideo" Color="Color.Error" Label="Auto-Desentrelaçamento" Dense="true" />
                                <MudCheckBox T="bool" @bind-Value="_model.AllowBFrames" Color="Color.Success" Label="Permitir B-Frames" Dense="true" />
                            </div>

                            @if (_model.NormalizeVideo)
                            {
                                <MudSelect T="ScalingBehavior" @bind-Value="_model.ScalingBehavior" For="@(() => _model.ScalingBehavior)" Label="Comportamento de Escala / Ajuste" Margin="Margin.Dense" Class="mb-3">
                                    <MudSelectItem Value="@ScalingBehavior.ScaleAndPad">Escalar com Barras Pretas (Scale &amp; Pad - Mantém Proporção)</MudSelectItem>
                                    <MudSelectItem Value="@ScalingBehavior.Stretch">Esticar para Preencher (Stretch)</MudSelectItem>
                                    <MudSelectItem Value="@ScalingBehavior.Crop">Cortar Bordas Excedentes (Crop)</MudSelectItem>
                                </MudSelect>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </div>
</MudForm>

@code {
    private CancellationTokenSource _cts;

    [Parameter]
    public int Id { get; set; }

    private FFmpegProfileEditViewModel _model = new();
    private readonly FFmpegProfileEditViewModelValidator _validator = new();
    private MudForm _form;
    private List<ResolutionViewModel> _resolutions = [];
    private List<HardwareAccelerationKind> _hardwareAccelerationKinds = [];
    private List<string> _vaapiDisplays = [];
    private List<string> _vaapiDevices = [];

    private bool IsEdit => Id != 0;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            _resolutions = await Mediator.Send(new GetAllResolutions(), token);
            _hardwareAccelerationKinds = await Mediator.Send(new GetSupportedHardwareAccelerationKinds(), token);

            if (RuntimeInformation.IsOSPlatform(OSPlatform.Linux))
            {
                if (!MemoryCache.TryGetValue("ffmpeg.vaapi_devices", out List<string> vaapiDevices))
                {
                    vaapiDevices = ["/dev/dri/renderD128"];
                }
                _vaapiDevices = vaapiDevices.OrderBy(s => s).ToList();

                if (!MemoryCache.TryGetValue("ffmpeg.vaapi_displays", out List<string> vaapiDisplays))
                {
                    vaapiDisplays = ["drm"];
                }
                _vaapiDisplays = vaapiDisplays.OrderBy(s => s).ToList();
            }

            if (IsEdit)
            {
                Option<FFmpegProfileViewModel> profile = await Mediator.Send(new GetFFmpegProfileById(Id), token);
                profile.Match(
                    vm => _model = new FFmpegProfileEditViewModel(vm),
                    () => NavigationManager.NavigateTo("ffmpeg"));
            }
            else
            {
                _model = new FFmpegProfileEditViewModel
                {
                    Name = "Novo Perfil",
                    NormalizeVideo = true,
                    NormalizeAudio = true,
                    VideoFormat = FFmpegProfileVideoFormat.H264,
                    AudioFormat = FFmpegProfileAudioFormat.Aac,
                    Resolution = _resolutions.FirstOrDefault(r => r.Height == 1080) ?? _resolutions.FirstOrDefault(),
                    VideoBitrate = 4500,
                    VideoBufferSize = 9000,
                    AudioBitrate = 192,
                    AudioBufferSize = 384,
                    AudioChannels = 2,
                    AudioSampleRate = 48
                };
            }
        }
        catch (OperationCanceledException)
        {
            // do nothing
        }
    }

    private void ApplyPreset1080p()
    {
        _model.Name = "1080p Full HD (Broadcast)";
        _model.NormalizeVideo = true;
        _model.NormalizeAudio = true;
        _model.VideoFormat = FFmpegProfileVideoFormat.H264;
        _model.VideoBitrate = 4500;
        _model.VideoBufferSize = 9000;
        _model.AudioFormat = FFmpegProfileAudioFormat.Aac;
        _model.AudioBitrate = 192;
        _model.AudioBufferSize = 384;
        _model.AudioChannels = 2;
        _model.AudioSampleRate = 48;
        var res = _resolutions.FirstOrDefault(r => r.Width == 1920 && r.Height == 1080) ?? _resolutions.FirstOrDefault(r => r.Height == 1080);
        if (res != null) _model.Resolution = res;
        Snackbar.Add("Predefinição 1080p Full HD aplicada.", Severity.Info);
    }

    private void ApplyPreset720p()
    {
        _model.Name = "720p HD (Padrão Web)";
        _model.NormalizeVideo = true;
        _model.NormalizeAudio = true;
        _model.VideoFormat = FFmpegProfileVideoFormat.H264;
        _model.VideoBitrate = 2500;
        _model.VideoBufferSize = 5000;
        _model.AudioFormat = FFmpegProfileAudioFormat.Aac;
        _model.AudioBitrate = 160;
        _model.AudioBufferSize = 320;
        _model.AudioChannels = 2;
        _model.AudioSampleRate = 48;
        var res = _resolutions.FirstOrDefault(r => r.Width == 1280 && r.Height == 720) ?? _resolutions.FirstOrDefault(r => r.Height == 720);
        if (res != null) _model.Resolution = res;
        Snackbar.Add("Predefinição 720p HD aplicada.", Severity.Info);
    }

    private void ApplyPreset480p()
    {
        _model.Name = "480p SD (Econômico)";
        _model.NormalizeVideo = true;
        _model.NormalizeAudio = true;
        _model.VideoFormat = FFmpegProfileVideoFormat.H264;
        _model.VideoBitrate = 1200;
        _model.VideoBufferSize = 2400;
        _model.AudioFormat = FFmpegProfileAudioFormat.Aac;
        _model.AudioBitrate = 128;
        _model.AudioBufferSize = 256;
        _model.AudioChannels = 2;
        _model.AudioSampleRate = 48;
        var res = _resolutions.FirstOrDefault(r => r.Height == 480);
        if (res != null) _model.Resolution = res;
        Snackbar.Add("Predefinição 480p SD aplicada.", Severity.Info);
    }

    private void ApplyPresetAudioOnly()
    {
        _model.Name = "Áudio Puro (Web Rádio)";
        _model.NormalizeVideo = false;
        _model.NormalizeAudio = true;
        _model.AudioFormat = FFmpegProfileAudioFormat.Aac;
        _model.AudioBitrate = 128;
        _model.AudioBufferSize = 256;
        _model.AudioChannels = 2;
        _model.AudioSampleRate = 44;
        Snackbar.Add("Predefinição Áudio Puro (Web Rádio) aplicada.", Severity.Info);
    }

    private async Task HandleSubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (IsEdit)
        {
            var updateCommand = _model.ToUpdate();
            var result = await Mediator.Send(updateCommand, _cts.Token);
            result.Match(
                _ =>
                {
                    Snackbar.Add("Perfil FFmpeg salvo com sucesso!", Severity.Success);
                    NavigationManager.NavigateTo("ffmpeg");
                },
                error =>
                {
                    Snackbar.Add(error.Value, Severity.Error);
                    Logger.LogError("Erro ao atualizar perfil FFmpeg: {Error}", error.Value);
                });
        }
        else
        {
            var createCommand = _model.ToCreate();
            var result = await Mediator.Send(createCommand, _cts.Token);
            result.Match(
                _ =>
                {
                    Snackbar.Add("Perfil FFmpeg criado com sucesso!", Severity.Success);
                    NavigationManager.NavigateTo("ffmpeg");
                },
                error =>
                {
                    Snackbar.Add(error.Value, Severity.Error);
                    Logger.LogError("Erro ao criar perfil FFmpeg: {Error}", error.Value);
                });
        }
    }
}
