@page "/media/rerun-collections/{Id:int}"
@using ErsatzTV.Application.MediaCards
@using ErsatzTV.Application.MediaCollections
@using ErsatzTV.Core.Domain
@using ErsatzTV.Shared
@using LanguageExt
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IMediator Mediator
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<MudForm Style="max-height: 100%">
    <div class="d-flex flex-column" style="height: 100vh; overflow-x: auto">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-10">

            @* Top Navigation & Header *@
            <div class="d-flex align-center justify-space-between mb-3">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="media/collections?tab=3" Class="mb-1">
                    Back to Collections
                </MudButton>

                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="OpenEditDialog">
                        Edit Rerun Collection
                    </MudButton>

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="DeleteThisCollection" />
                </div>
            </div>

            <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-4">
                <div>
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Repeat" Color="Color.Secondary" Size="Size.Medium" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold">
                            @(_data?.Name ?? "Loading Rerun Collection...")
                        </MudText>
                    </div>
                    <div class="d-flex align-center flex-wrap gap-2 mt-1">
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                            Rerun Marathon
                        </MudChip>
                        @if (_data != null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Source">
                                @GetSourceLabel()
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.PlayArrow">
                                First Run: @_data.FirstRunPlaybackOrder.ToString()
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Loop">
                                Rerun: @_data.RerunPlaybackOrder.ToString()
                            </MudChip>
                        }
                    </div>
                </div>
            </div>

            @* Rerun Behavior Explanatory Card *@
            <MudPaper Class="pa-4 mb-6" Elevation="0" Outlined="true" Style="border-radius: 8px;">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Medium" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                            Dual-Phase Marathon Behavior
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            This collection provides two distinct pools in channel schedules:
                            <strong>First Run</strong> broadcasts air new, unwatched episodes in sequence (@(_data?.FirstRunPlaybackOrder.ToString() ?? "Sequential")).
                            Once an episode has aired once, it dynamically enters the <strong>Rerun</strong> pool for repeat broadcasts (@(_data?.RerunPlaybackOrder.ToString() ?? "Shuffle")).
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            @* Content Area *@
            @if (_isLoading)
            {
                <div class="d-flex justify-center mt-12 mb-12">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (_data != null)
            {
                <MudText Typo="Typo.h6" Class="mb-3 font-weight-bold">
                    Source Configuration
                </MudText>

                <MudCard Elevation="0" Outlined="true" Class="mb-5">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between flex-wrap gap-4">
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Target Source Type</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@_data.CollectionType.ToString()</MudText>
                            </div>

                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Source Entity Name</MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@GetSourceEntityName()</MudText>
                            </div>

                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">First Run Sequence</MudText>
                                <MudText Typo="Typo.body2">@_data.FirstRunPlaybackOrder.ToString()</MudText>
                            </div>

                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Rerun Sequence</MudText>
                                <MudText Typo="Typo.body2">@_data.RerunPlaybackOrder.ToString()</MudText>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(GetSourceTargetUrl()))
                            {
                                <div>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.OpenInNew"
                                               Href="@GetSourceTargetUrl()">
                                        Inspect Source
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center my-6" Elevation="0" Outlined="true" Style="border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Unable to load rerun collection</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="media/collections?tab=3" Class="mt-3">
                        Back to Collections
                    </MudButton>
                </MudPaper>
            }

        </MudContainer>
    </div>
</MudForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private RerunCollectionViewModel _data;
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync() => await RefreshData();

    private async Task RefreshData()
    {
        _isLoading = true;
        try
        {
            var maybe = await Mediator.Send(new GetRerunCollectionById(Id), _cts.Token);
            maybe.Match(
                rc => _data = rc,
                () => NavigationManager.NavigateTo("404"));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading rerun collection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetSourceEntityName() => _data switch
    {
        { MediaItem: not null } => _data.MediaItem.Name,
        { Collection: not null } => _data.Collection.Name,
        { SmartCollection: not null } => _data.SmartCollection.Name,
        { MultiCollection: not null } => _data.MultiCollection.Name,
        _ => "Not configured"
    };

    private string GetSourceLabel() => $"{_data.CollectionType}: {GetSourceEntityName()}";

    private string GetSourceTargetUrl()
    {
        if (_data == null) return null;

        return _data.CollectionType switch
        {
            CollectionType.TelevisionShow when _data.MediaItem != null =>
                $"media/tv/shows/{_data.MediaItem.MediaItemId}",
            CollectionType.TelevisionSeason when _data.MediaItem != null =>
                $"media/tv/seasons/{_data.MediaItem.MediaItemId}",
            CollectionType.Artist when _data.MediaItem != null =>
                $"media/music/artists/{_data.MediaItem.MediaItemId}",
            CollectionType.Collection when _data.Collection != null =>
                $"media/collections/{_data.Collection.Id}",
            CollectionType.SmartCollection when _data.SmartCollection != null =>
                $"media/smart-collections/{_data.SmartCollection.Id}",
            CollectionType.MultiCollection when _data.MultiCollection != null =>
                $"media/multi-collections/{_data.MultiCollection.Id}",
            _ => null
        };
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters { { "Id", Id } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await Dialog.ShowAsync<RerunCollectionDialog>("Edit Rerun Collection", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshData();
        }
    }

    private async Task DeleteThisCollection()
    {
        if (_data == null) return;

        var parameters = new DialogParameters { { "EntityType", "rerun collection" }, { "EntityName", _data.Name } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await Dialog.ShowAsync<DeleteDialog>("Delete Rerun Collection", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Mediator.Send(new DeleteRerunCollection(_data.Id), _cts.Token);
            Snackbar.Add($"Rerun collection '{_data.Name}' deleted.", Severity.Success);
            NavigationManager.NavigateTo("media/collections?tab=3");
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
