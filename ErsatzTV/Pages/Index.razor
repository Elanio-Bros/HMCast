@page "/"
@using ErsatzTV.Application.Channels.Queries
@using ErsatzTV.Core.Domain
@using ErsatzTV.Locals.Pages
@using ErsatzTV.Shared
@implements IDisposable
@inject IMediator Mediator
@inject IDialogService Dialog
@inject IStringLocalizer<Dashboard> Loc
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-12">
    <!-- Header com Telemetria de Transmissão -->
    <div class="d-flex flex-wrap justify-space-between align-center mb-6">
        <div>
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.LiveTv" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.5px;">@Loc["Title_Dashboard"]</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@Loc["Subtitle_Dashboard"]</MudText>
        </div>
        <div class="d-flex align-center gap-2 mt-4 mt-sm-0">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_isLoading"
                       OnClick="@ManualRefreshAsync">
                @Loc["Btn_Refresh"]
            </MudButton>
        </div>
    </div>

    <!-- Hero Cards de Telemetria Operacional -->
    <MudGrid Class="mb-8" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column justify-space-between" Elevation="2" Style="border-left: 4px solid var(--mud-palette-success); height: 100%;">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase font-weight-bold">@Loc["Card_ActiveChannels"]</MudText>
                        <MudText Typo="Typo.h3" Style="font-weight: 700; color: var(--mud-palette-success);">
                            @(_dashboardData?.ActiveChannelsCount ?? 0) <span style="font-size: 1.1rem; color: var(--mud-palette-text-secondary); font-weight: normal;">/ @(_dashboardData?.TotalChannelsCount ?? 0)</span>
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Rounded="true">
                        <MudIcon Icon="@Icons.Material.Filled.CellTower" />
                    </MudAvatar>
                </div>
                <div class="d-flex align-center gap-1 mt-3">
                    <div style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--mud-palette-success);"></div>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-success); font-weight: 600;">@Loc["Badge_OnAir"]</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column justify-space-between" Elevation="2" Style="border-left: 4px solid var(--mud-palette-info); height: 100%;">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase font-weight-bold">@Loc["Card_ActivePlayouts"]</MudText>
                        <MudText Typo="Typo.h3" Style="font-weight: 700; color: var(--mud-palette-info);">
                            @(_dashboardData?.ActivePlayoutsCount ?? 0)
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Rounded="true">
                        <MudIcon Icon="@Icons.Material.Filled.ViewTimeline" />
                    </MudAvatar>
                </div>
                <div class="d-flex align-center gap-1 mt-3">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Color="Color.Info" />
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-info); font-weight: 600;">Automated Schedules</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column justify-space-between" Elevation="2" Style="border-left: 4px solid var(--mud-palette-primary); height: 100%;">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase font-weight-bold">@Loc["Card_ZeroDelay"]</MudText>
                        <MudText Typo="Typo.h3" Style="font-weight: 700; color: var(--mud-palette-primary);">
                            @(_dashboardData?.PreCacheChannelsCount ?? 0)
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" />
                    </MudAvatar>
                </div>
                <div class="d-flex align-center gap-1 mt-3">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-primary); font-weight: 600;">@Loc["Label_TelemetriaZeroGPU"]</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 d-flex flex-column justify-space-between" Elevation="2" Style="border-left: 4px solid var(--mud-palette-secondary); height: 100%;">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase font-weight-bold">@Loc["Card_TotalMedia"]</MudText>
                        <MudText Typo="Typo.h3" Style="font-weight: 700; color: var(--mud-palette-secondary);">
                            @(_dashboardData?.TotalLibraryHours ?? 0) <span style="font-size: 1.1rem; color: var(--mud-palette-text-secondary); font-weight: normal;">h</span>
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Rounded="true">
                        <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" />
                    </MudAvatar>
                </div>
                <div class="d-flex align-center gap-1 mt-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-secondary); font-weight: 600;">Library Indexed</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Grid de Canais em Transmissão -->
    @if (_dashboardData == null && _isLoading)
    {
        <div class="d-flex justify-center align-center pa-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (_dashboardData?.Channels == null || _dashboardData.Channels.Count == 0)
    {
        <MudCard Class="pa-8 text-center" Elevation="1">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.LiveTv" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                <MudText Typo="Typo.h6">@Loc["Label_NoChannels"]</MudText>
            </MudCardContent>
            <MudCardActions Class="justify-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="channels/add">
                    @Loc["Btn_CreateFirstChannel"]
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (BroadcastDashboardChannelItem channel in _dashboardData.Channels)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="3" Style="height: 100%; display: flex; flex-direction: column; border-radius: 8px; overflow: hidden; background: rgba(30, 34, 45, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.05);">
                        <MudCardHeader Class="pb-2">
                            <CardHeaderAvatar>
                                @if (!string.IsNullOrWhiteSpace(channel.Logo?.Path))
                                {
                                    <img src="@channel.Logo.Path" alt="@channel.Name" style="width: 44px; height: 44px; object-fit: contain; border-radius: 4px; background: rgba(0,0,0,0.2); padding: 2px;" />
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Dark" Variant="Variant.Filled" Rounded="true" Style="width: 44px; height: 44px;">
                                        <MudIcon Icon="@(channel.Mode == ChannelMode.Radio ? Icons.Material.Filled.Radio : Icons.Material.Filled.Tv)" />
                                    </MudAvatar>
                                }
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <div class="d-flex align-center gap-1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="font-weight: 700; height: 20px; font-size: 0.75rem;">
                                        @channel.Number
                                    </MudChip>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 130px;" title="@channel.Name">
                                        @channel.Name
                                    </MudText>
                                </div>
                                <div class="d-flex align-center gap-1 mt-1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Style="height: 18px; font-size: 0.7rem;">
                                        @(channel.Mode == ChannelMode.Radio ? Loc["Label_Mode_Radio"] : Loc["Label_Mode_TV"])
                                    </MudChip>
                                </div>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                @if (channel.IsOnAir)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-weight: 700; font-size: 0.7rem;">
                                        <div class="mr-1" style="width: 6px; height: 6px; border-radius: 50%; background: #ffffff;"></div>
                                        @Loc["Badge_OnAir"]
                                    </MudChip>
                                }
                                else if (channel.PreCache > 0 && channel.IsEnabled)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Style="font-weight: 600; font-size: 0.65rem;">
                                        @Loc["Badge_PreCache"]
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Style="font-size: 0.7rem;">
                                        @Loc["Badge_Offline"]
                                    </MudChip>
                                }
                            </CardHeaderActions>
                        </MudCardHeader>

                        <MudCardContent Class="py-2 flex-grow-1">
                            @if (channel.IsOnAir && !string.IsNullOrWhiteSpace(channel.CurrentItemTitle))
                            {
                                <div class="mb-2">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase" Style="font-size: 0.7rem; font-weight: 600;">
                                            @Loc["Label_PlayingNow"]
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem;">
                                            @channel.ProgressPercentage%
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.25; min-height: 2.5em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@channel.CurrentItemTitle">
                                        @channel.CurrentItemTitle
                                    </MudText>
                                </div>
                                <MudProgressLinear Color="Color.Success" Value="@channel.ProgressPercentage" Rounded="true" Size="Size.Small" Class="mb-3" />

                                @if (!string.IsNullOrWhiteSpace(channel.NextItemTitle))
                                {
                                    <div class="d-flex align-start gap-1">
                                        <MudIcon Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" Color="Color.Default" Style="font-size: 1rem; margin-top: 1px;" />
                                        <div style="min-width: 0;">
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size: 0.7rem; display: block;">
                                                @Loc["Label_UpNext"]
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;" title="@channel.NextItemTitle">
                                                @channel.NextItemTitle
                                            </MudText>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-center align-center pa-4 text-center" style="min-height: 90px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Default" Size="Size.Medium" Class="mb-1" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Label_NoSchedule"]</MudText>
                                </div>
                            }
                        </MudCardContent>

                        <MudCardActions Class="pa-3 pt-0 d-flex justify-space-between align-center" Style="border-top: 1px solid rgba(255,255,255,0.05);">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayCircleOutline"
                                       OnClick="@(() => WatchPreview(channel))">
                                @Loc["Btn_Preview"]
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                           Color="Color.Default"
                                           Size="Size.Small"
                                           Href="@($"channels/{channel.ChannelId}/edit")"
                                           title="@Loc["Btn_Manage"]" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private BroadcastDashboardModel _dashboardData;
    private bool _isLoading = true;
    private CancellationTokenSource _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadDashboardAsync(_cts.Token);
        _ = StartPeriodicUpdateLoopAsync(_cts.Token);
    }

    private async Task LoadDashboardAsync(CancellationToken cancellationToken)
    {
        try
        {
            _isLoading = true;
            _dashboardData = await Mediator.Send(new GetBroadcastDashboard(), cancellationToken);
        }
        catch (OperationCanceledException)
        {
            // Esperado no cancelamento
        }
        catch (Exception)
        {
            // Manter estado anterior em caso de erro transitório de rede
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task StartPeriodicUpdateLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                if (await timer.WaitForNextTickAsync(cancellationToken))
                {
                    _dashboardData = await Mediator.Send(new GetBroadcastDashboard(), cancellationToken);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception)
            {
                // Ignorar erro transitório e prosseguir no próximo ciclo
            }
        }
    }

    private async Task ManualRefreshAsync()
    {
        if (_cts != null && !_cts.IsCancellationRequested)
        {
            await LoadDashboardAsync(_cts.Token);
        }
    }

    private async Task WatchPreview(BroadcastDashboardChannelItem channel)
    {
        var parameters = new DialogParameters
        {
            { "StreamUri", $"iptv/channel/{channel.Number}.m3u8" }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await Dialog.ShowAsync<ChannelPreviewDialog>($"{channel.Number} - {channel.Name}", parameters, options);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
