# Configurações do Sistema de TV

# --- Banco de Dados ---
# Caminho para o arquivo do banco de dados SQLite
DB_PATH=./data/tv.db

# --- Binários ---
# Se o ffmpeg/ffprobe não estiverem no PATH, defina o caminho absoluto aqui
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- Transmissão (HLS) ---
# Tempo máximo (segundos) para esperar a playlist ser gerada no primeiro acesso
HLS_PLAYLIST_WARMUP_TIMEOUT=15

# Intervalo (segundos) entre ciclos de pré-renderização para canais PREDICTIVE
PREDICTIVE_WARMUP_INTERVAL=300

# Tamanho do GOP (Group of Pictures) para o FFmpeg (afeta latência e qualidade)
HLS_GOP_SIZE=50

# --- Automação de Mídias ---
# Intervalo (segundos) entre scans automáticos de pastas de mídia
MEDIA_AUTO_SCAN_INTERVAL=600

# --- Opções Extras ---
# Se definido como 1, gera áudio silencioso se o arquivo original falhar
AUDIO_SILENCE_FALLBACK=0

# Caminho para imagem exibida em canais de rádio
# RADIO_BACKGROUND_IMAGE=./assets/radio_bg.png

# Tempo de tolerância (ms) para o FFmpeg iniciar antes de checagem de erro
PLAYER_STARTUP_GRACE_MS=1000

# --- TUI ---
# Limite de itens por página nas listagens do banco de dados
CLI_PAGE_SIZE=10
